rules_version = '2';
// 排行榜：每種排行一個集合，文件 ID 就是玩家的匿名帳號 ID
// 社會任務：lb_score 單次最高分、lb_correct 累積答對題數、lb_time 全對最快、lb_lv 等級用的 XP
// 閱讀素養：每個閱讀等級分開，rd{1-6}_stars 星星總數、rd{1-6}_correct 累積答對題數、rd{1-6}_reads 讀完篇數、rd{1-6}_xp 經驗值
// 大家都能讀；只能寫自己的那一筆，而且欄位和數字要合理，分數只能越寫越好
service cloud.firestore {
  match /databases/{database}/documents {
    match /{board}/{uid} {
      allow read: if isBoard(board);
      allow write: if isBoard(board)
        && request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pet', 'value'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 12
        && request.resource.data.pet is string && request.resource.data.pet.size() <= 8
        && request.resource.data.value is number
        && okValue(board, request.resource.data.value)
        && (resource == null || notWorse(board, request.resource.data.value, resource.data.value));
    }
    function isBoard(board) {
      return board in ['lb_score', 'lb_correct', 'lb_time', 'lb_lv']
          || board.matches('rd[1-6]_(stars|correct|reads|xp)');
    }
    function okValue(board, v) {
      return (board == 'lb_score' && v >= 0 && v <= 10000)
          || (board == 'lb_correct' && v >= 0 && v <= 1000000)
          || (board == 'lb_time' && v >= 20 && v <= 36000)
          || (board == 'lb_lv' && v >= 0 && v <= 100000000)
          || (board.matches('rd[1-6]_stars') && v >= 0 && v <= 3000)
          || (board.matches('rd[1-6]_(correct|reads)') && v >= 0 && v <= 1000000)
          || (board.matches('rd[1-6]_xp') && v >= 0 && v <= 100000000);
    }
    function notWorse(board, v, old) {
      return board == 'lb_time' ? v <= old : v >= old;
    }
  }
}
